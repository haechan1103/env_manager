{
  "schemaVersion": 2,
  "catalogVersion": "3.2.0",
  "providerProtocolVersion": "0.4.0",
  "lastReviewed": "2026-08-17",
  "providers": [
    {
      "id": "github-actions",
      "displayName": "GitHub Actions",
      "adapterVersion": "1.0.0",
      "uiSupport": "implemented",
      "agentSupport": "implemented",
      "transport": "cli",
      "client": {
        "name": "gh",
        "runtimeProbe": "semantic-version",
        "profiles": [
          {
            "id": "gh-secret-set-v1",
            "strategy": "gh-secret-set-v1",
            "versionRequirement": ">=0.0.0"
          }
        ]
      },
      "valueTransport": "stdin",
      "capabilities": [
        "repository-secret",
        "repository-variable",
        "environment-secret",
        "environment-variable",
        "repository-discovery",
        "environment-discovery",
        "environment-create"
      ],
      "officialDocs": [
        "https://cli.github.com/manual/gh_secret_set",
        "https://cli.github.com/manual/gh_variable_set",
        "https://cli.github.com/manual/gh_api"
      ]
    },
    {
      "id": "cloudflare-workers",
      "displayName": "Cloudflare Workers",
      "adapterVersion": "1.0.0",
      "uiSupport": "implemented",
      "agentSupport": "implemented",
      "transport": "cli",
      "client": {
        "name": "wrangler",
        "runtimeProbe": "semantic-version",
        "profiles": [
          {
            "id": "wrangler-secret-bulk-v1",
            "strategy": "wrangler-secret-bulk-v1",
            "versionRequirement": ">=4.0.0,<5.0.0"
          }
        ]
      },
      "valueTransport": "stdin",
      "capabilities": [
        "worker-secret-immediate",
        "worker-discovery",
        "wrangler-environment-discovery"
      ],
      "officialDocs": [
        "https://developers.cloudflare.com/workers/wrangler/commands/workers/",
        "https://developers.cloudflare.com/workers/configuration/secrets/",
        "https://developers.cloudflare.com/workers/wrangler/configuration/"
      ]
    },
    {
      "id": "aws-secrets-manager",
      "displayName": "AWS Secrets Manager",
      "adapterVersion": "1.1.0",
      "uiSupport": "implemented",
      "agentSupport": "implemented",
      "transport": "sdk",
      "client": {
        "name": "aws-sdk-rust-secretsmanager",
        "runtimeProbe": "sdk-config-chain",
        "profiles": []
      },
      "valueTransport": "in-process-sdk",
      "capabilities": [
        "secret-create",
        "secret-version-update",
        "aws-profile",
        "aws-region",
        "sts-preflight",
        "kms-key-select",
        "kms-alias-discovery",
        "secret-value-compare"
      ],
      "officialDocs": [
        "https://docs.aws.amazon.com/cli/latest/reference/secretsmanager/put-secret-value.html",
        "https://docs.aws.amazon.com/sdk-for-rust/latest/dg/credproviders.html",
        "https://docs.aws.amazon.com/secretsmanager/latest/userguide/security-encryption.html",
        "https://docs.aws.amazon.com/secretsmanager/latest/apireference/API_GetSecretValue.html"
      ]
    },
    {
      "id": "aws-ssm-parameter-store",
      "displayName": "AWS Systems Manager Parameter Store",
      "adapterVersion": "1.1.0",
      "uiSupport": "implemented",
      "agentSupport": "implemented",
      "transport": "sdk",
      "client": {
        "name": "aws-sdk-rust-ssm",
        "runtimeProbe": "sdk-config-chain",
        "profiles": []
      },
      "valueTransport": "in-process-sdk",
      "capabilities": [
        "secure-string-create",
        "secure-string-update",
        "aws-profile",
        "aws-region",
        "sts-preflight",
        "kms-key-select",
        "kms-alias-discovery",
        "secure-string-value-compare"
      ],
      "officialDocs": [
        "https://docs.aws.amazon.com/cli/latest/reference/ssm/put-parameter.html",
        "https://docs.aws.amazon.com/sdk-for-rust/latest/dg/credproviders.html",
        "https://docs.aws.amazon.com/systems-manager/latest/userguide/secure-string-parameter-kms-encryption.html",
        "https://docs.aws.amazon.com/systems-manager/latest/APIReference/API_GetParameter.html"
      ]
    },
    {
      "id": "remote-runtime",
      "displayName": "Remote Runtime",
      "adapterVersion": "1.0.0",
      "uiSupport": "implemented",
      "agentSupport": "implemented",
      "transport": "remote-verifier",
      "client": {
        "name": "env-manager-remote-verifier",
        "runtimeProbe": "fixed-protocol",
        "profiles": []
      },
      "valueTransport": "age-stdin",
      "capabilities": [
        "ssh-runtime-compare",
        "server-target-allowlist",
        "request-freshness",
        "request-replay-protection"
      ],
      "officialDocs": [
        "https://man.openbsd.org/ssh",
        "https://age-encryption.org/v1"
      ]
    }
  ]
}
