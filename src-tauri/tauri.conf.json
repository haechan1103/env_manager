{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Env Manager",
  "version": "0.5.1",
  "identifier": "dev.hgc.env-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "Env Manager",
        "width": 1240,
        "height": 820,
        "minWidth": 920,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3RkYzRDRFNDZFMjhDQzIKUldUQ2pPSkdUajMvZHdYSjVCWHB3WWV4eTV4Q3dnZSt2aW83M0MxaVZndFNIM0Y5M1lZYXR0ZzUK",
      "endpoints": [
        "https://github.com/haechan1103/env_manager/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/env-manager-broker"],
    "resources": {
      "../plugins/env-manager/": "agent-integrations/catalog/plugins/env-manager",
      "../.agents/plugins/marketplace.json": "agent-integrations/catalog/.agents/plugins/marketplace.json",
      "../.claude-plugin/marketplace.json": "agent-integrations/catalog/.claude-plugin/marketplace.json"
    }
  }
}
